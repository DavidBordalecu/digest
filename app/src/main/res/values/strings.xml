    <!-- Escala de Bristol -->
    <string name="bristol_1">1 · Heces duras sueltas</string>
    <string name="bristol_1_desc">Trozos separados y duros, como nueces. Estreñimiento.</string>
    <string name="bristol_2">2 · En forma de salchicha grumosa</string>
    <string name="bristol_2_desc">Agrupadas pero irregulares, como una salchicha grumosa.</string>
    <string name="bristol_3">3 · Salchicha con grietas</string>
    <string name="bristol_3_desc">Como una salchicha pero con grietas en la superficie. Normal.</string>
    <string name="bristol_4">4 · Suave y lisa</string>
    <string name="bristol_4_desc">Como una serpiente, suave y lisa. Ideal.</string>
    <string name="bristol_5">5 · Trozos blandos con bordes</string>
    <string name="bristol_5_desc">Trozos blandos con bordes definidos. Ligera diarrea.</string>
    <string name="bristol_6">6 · Trozos blandos deshilachados</string>
    <string name="bristol_6_desc">Blandos, con bordes deshilachados, aspecto de papilla.</string>
    <string name="bristol_7">7 · Líquidas, sin trozos</string>
    <string name="bristol_7_desc">Totalmente líquidas, sin restos sólidos. Diarrea severa.</string>

