<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fondo del icono: degradado verde azulado de la marca.

  Se declara como vector con degradado en lugar de color plano porque el
  degradado da profundidad sin añadir peso al APK, y porque el icono
  adaptativo lo va a recortar con la máscara del lanzador.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF12949B" />
                <item android:offset="0.55" android:color="#FF00696E" />
                <item android:offset="1.0" android:color="#FF32474E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>