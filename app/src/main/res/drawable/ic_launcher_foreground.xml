<?xml version="1.0" encoding="UTF-8"?>
<!--
  Marca de Digest: el marco del colon dibujado con un trazo continuo.

  El diseño maestro está en 512x512 (logo/logo.svg); aquí se reduce y se
  centra dentro de la zona segura del icono adaptativo, que es el círculo
  central de 66x66 sobre un lienzo de 108x108. Todo lo que se salga de esa
  zona lo recortaría el lanzador en según qué formas.

  El trazo va escalado por un <group>, no dibujado ya reducido: así el
  grosor de línea se mantiene proporcional al dibujo maestro.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.28"
        android:scaleY="0.28"
        android:translateX="-19.4"
        android:translateY="-19.5">

        <path
            android:pathData="M176,356
                             C160,316 154,246 156,192
                             C157,166 180,152 206,152
                             L318,152
                             C344,152 367,166 368,192
                             C370,250 366,298 362,328
                             C356,366 318,380 290,358
                             C268,340 272,310 296,302"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="44"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>